# APMS environment template
# Copy this file to .env for server/CLI use. Never commit the populated file.

# Supabase client values (safe for the Expo client bundle).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Use true only for fictional local demonstrations and automated browser tests.
EXPO_PUBLIC_DEMO_MODE=false

# Supabase server/administration values. Never prefix these with EXPO_PUBLIC_.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SUPABASE_DB_PASSWORD=your_database_password

# APMS AI service. The built-in prototype uses controlled synthetic data only.
APMS_AI_SERVICE_URL=http://127.0.0.1:8000
APMS_AI_SERVICE_TOKEN=replace_with_a_long_random_server_token
APMS_MODEL_ARTIFACT_PATH=
APMS_MODEL_VERSION=synthetic-logistic-demo-v1
APMS_AI_ENABLE_SYNTHETIC_DEMO=true
