{
  "name": "apms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @apms/mobile run web",
    "build": "npm run typecheck && npm --workspace @apms/mobile run export:web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:schema": "node scripts/verify-schema.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@playwright/test": "^1.55.0",
    "expo-router": "~57.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "supabase": "^2.40.7",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
